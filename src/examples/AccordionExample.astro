---
import type { ComponentProps } from "astro/types";
import Accordion from "@components/Accordion.astro";

interface Props {
  variant?: ComponentProps<typeof Accordion>["variant"];
}
const { variant = "chevron" } = Astro.props;

const items: ComponentProps<typeof Accordion>["items"] = [
  {
    title: "Item 1",
    content: "Content 1",
  },
  {
    title: "Item 2",
    content: "Content 2",
  },
  {
    title: "Item 3",
    content: "Content 3",
  },
  {
    title: "Item 4",
    content: "Content 4",
  },
  {
    title: "Item 5",
    content: "Content 5",
  },
];
---

<Accordion variant={variant} items={items} />

<script>
  import "@lib/accordion";
</script>
