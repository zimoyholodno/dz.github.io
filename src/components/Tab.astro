---
import Pill from "./Pill.astro";

interface Props {
  items: string[];
  open: number;
}

const { items, open } = Astro.props;
---

<div class:list={["tab"]} data-open={open}>
  <div class="tab__header">
    <div class="tab__list">
      {items.map((tab) => <Pill>{tab}</Pill>)}
    </div>
    <!-- <slot name="options" /> -->
  </div>
  <div class="tab__container">
    <slot />
  </div>
</div>

<style is:global lang="scss">
  .tab {
    display: flex;
    flex-direction: column;
    gap: 20px;

    // gap: fluid(20px, 30px);

    @include laptop-min {
      gap: 50px;
    }

    &__header {
      display: flex;
      justify-content: center;
      align-items: center;
      justify-content: space-between;

      width: 100%;
      height: 100%;

      scroll-behavior: smooth;
      // scrollbar-width: thin;
      scrollbar-width: none;
      overflow: auto;
    }

    &__list {
      display: flex;
      width: 100%;

      // gap: fluid(5px, 10px);
      gap: 30px;

      font-weight: 600;
      font-size: 11px;
      line-height: 1;
      letter-spacing: 1.65px;

      text-transform: uppercase;

      // justify-content: space-between;
      // flex-wrap: wrap;

      // color: var(--color-beige-500);

      & > *:last-child {
        // margin-right: $p;
      }
    }

    &__item {
    }

    &__container {
      width: 100%;
    }

    &__content {
      display: none;
      // gap: fluid(30px, 60px);
      opacity: 0;
      transition: opacity var(--transition);

      &--active {
        display: flex;
        flex-direction: column;
      }

      &--opacity {
        opacity: 1;
      }
    }
  }
</style>
