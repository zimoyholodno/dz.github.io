---
interface Props {}

const {} = Astro.props;

const nav1 = ["О компании", "Бренды", "Акции", "Доставка и оплата"];

const nav2 = ["Гарантия", "Отзывы", "Блог", "Контакты"];
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__content">
      <a href="#" class="footer__logo"
        ><img src="img/full-logo.svg" alt="" class="footer__logo-img" /></a
      >

      <div class="footer__cont">
        <p>
          Lorem ipsum dolor sit amet consectet adipiscing elit eget quamumto.
          Lorem ipsum dolor sit amet consectet adipiscing elit eget quamumto.
          Lorem ipsum dolor sit amet consectet adipiscing
        </p>
        <div class="footer__cont-data">
          <p>г. Город, ул. Уличная, д. 82, этаж 4, офис 488</p>
          <p>ИНН 60000000000 ОГРН 0000000000</p>
        </div>
      </div>
    </div>

    <div class="footer__nav-one">
      {
        nav1.map((item) => (
          <a href="#" class="footer__nav-item">
            {item}
          </a>
        ))
      }
    </div>
    <div class="footer__nav-two">
      {
        nav2.map((item) => (
          <a href="#" class="footer__nav-item">
            {item}
          </a>
        ))
      }
    </div>

    <div class="footer__cont-number">
      <div class="footer__text">
        <p class="footer__text-number">+7 900 000 00 00</p>
        <p class="footer__mail">example@email.com</p>
      </div>
    </div>

    <p class="footer__prava">© 2025 Все права защищены</p>
    <a href="#" class="footer__conf">Политика конфиденциальности</a>
    <a href="#" class="footer__data">Обработка данных</a>
  </div>
</footer>

<style is:global lang="scss">
  .footer {
    @include section;
    flex-grow: 0;

    background-color: var(--color-slate-950);
    color: var(--color-slate-400);

    &__container {
      grid-area: center;

      display: grid;

      grid-template-areas:
        "logo"
        "number"
        "conf"
        "data"
        "company"
        "prava";

      padding-block: 30px;

      @include laptop-min {
        row-gap: 36px;
        grid-template-areas:
          "logo nav1 nav2  nav2 number"
          "logo nav1 nav2 nav2 number"
          "logo . . . ."
          ". . . . ."
          "prava conf data data company";

        justify-items: start;

        padding-top: 50px;
        padding-bottom: 60px;

        grid-template-columns: auto 268px auto 1fr 206px;
      }
      @include desktop-min {
        grid-template-columns: auto 268px auto 1fr 306px;
      }
    }

    &__content {
      grid-area: logo;

      display: grid;
      gap: 50px;

      @include laptop-min {
        gap: 30px;
        padding-right: 20px;
      }

      @include desktop-min {
        padding-right: 123px;
      }
    }

    &__logo {
      // grid-area: logo;
      height: 40px;
      display: flex;
      justify-content: center;

      &-img {
        height: 100%;
        object-fit: contain;
      }

      @include laptop-min {
        height: 76px;
        justify-content: flex-start;
      }
    }

    &__cont {
      // grid-area: cont;
      text-align: center;
      font-weight: 400;
      font-size: 11px;
      line-height: 1.7;

      display: flex;
      flex-direction: column;
      gap: 30px;

      margin-bottom: 50px;

      &-data {
        display: flex;
        flex-direction: column;
        gap: 15px;
      }

      &-number {
        grid-area: number;

        display: flex;
        flex-direction: column;
        gap: 40px;

        text-align: center;
        align-items: center;

        margin-bottom: 50px;

        @include laptop-min {
          align-items: flex-start;
          margin-bottom: unset;
          text-align: unset;
        }
      }

      @include laptop-min {
        max-width: 334px;
        margin-bottom: unset;
        text-align: unset;

        justify-items: start;
        // text-wrap: balance;

        font-size: 14px;
        line-height: 1.3;
        gap: 40px;
      }
    }

    &__text {
      display: flex;
      flex-direction: column;
      gap: 20px;

      font-weight: 400;
      font-size: 18px;
      line-height: 1;

      &-number {
        font-weight: 600;
        font-size: 24px;
        line-height: 1;

        color: var(--color-white);
      }
    }

    &__nav {
      &-one {
        font-weight: 400;
        font-size: 14px;
        line-height: 100%;
        text-transform: lowercase;

        display: none;
        text-transform: lowercase;
        color: var(--color-white);
        grid-area: nav1;

        @include laptop-min {
          display: flex;
          flex-direction: column;
          gap: 24px;
        }
      }

      &-two {
        font-weight: 400;
        font-size: 14px;
        line-height: 100%;
        text-transform: lowercase;

        display: none;

        text-transform: lowercase;
        color: var(--color-white);
        grid-area: nav2;

        @include laptop-min {
          display: flex;
          flex-direction: column;
          gap: 24px;
        }
      }
    }

    &__prava {
      grid-area: prava;

      @include laptop-min {
        align-self: center;
      }
    }

    &__conf {
      grid-area: conf;
      font-weight: 400;
      font-size: 14px;
      line-height: 1.2;

      color: var(--color-white);

      text-align: center;
      margin-bottom: 30px;

      @include laptop-min {
        margin-bottom: unset;
        align-self: center;
      }
    }

    &__data {
      grid-area: data;
      font-weight: 400;
      font-size: 14px;
      line-height: 1.2;
      text-align: center;

      color: var(--color-white);
      margin-bottom: 50px;

      @include laptop-min {
        margin-bottom: unset;
        align-self: center;
      }
    }

    &__company-desc {
      grid-area: company;
      display: flex;
      gap: 12px;
      align-items: center;

      justify-content: center;

      font-weight: 400;
      font-size: 14px;
      line-height: 1.3;

      margin-bottom: 30px;

      &--img {
        width: 46px;
      }

      @include laptop-min {
        justify-self: end;
        margin-bottom: unset;
        align-self: center;
        justify-content: flex-end;
      }
    }

    &__prava {
      font-weight: 400;
      font-size: 14px;
      line-height: 1.3;
      text-align: center;

      @include laptop-min {
        align-self: center;
      }
    }
  }
</style>
