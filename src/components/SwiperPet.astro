---

<div class="swiper-pet">
  <div class="swiper-pet__content">
    <div class="swiper-pet__content-container">
      <Title size="small">
        {title}
      </Title>
      <div class="swiper-pet__nav">
        <div
          class:list={[
            "swiper-pet__nav-prev",
            name && `swiper-pet__nav-prev--${name}`,
          ]}
        >
          <Icon icon="line" />
        </div>
        <div
          class:list={[
            "swiper-pet__nav-next",
            name && `swiper-pet__nav-next--${name}`,
          ]}
        >
          <Icon icon="line" />
        </div>
      </div>
    </div>
  </div>
  <div
    class:list={[
      "swiper-pet__swiper swiper",
      name && `swiper-pet__swiper--${name}`,
    ]}
  >
    <div class="swiper-pet__wrapper swiper-wrapper">
      {
        list.map((item) => (
          <div class="swiper-pet__slide swiper-slide">
            <PetCard {...item} />
          </div>
        ))
      }
    </div>
  </div>
</div>

<style is:global lang="scss">
  .swiper-pet {
    // padding-top: 17px;
    &__content {
      display: flex;
      width: 100%;
      justify-content: flex-end;

      &-container {
        gap: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;

        padding-bottom: 20px;

        @include laptop-min {
          padding-bottom: 40px;
        }

        @include desktop-min {
          max-width: 715px;
        }
      }
    }

    &__nav {
      display: flex;
      align-items: center;
      gap: 8px;

      @include tablet-min {
        gap: 12px;
      }

      @include laptop-min {
        justify-content: space-between;
        width: 68px;
      }

      &-prev,
      &-next {
        // width: 32px;
        // height: 32px;

        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 100%;

        cursor: pointer;
      }

      &-prev {
        transform: rotate(180deg);
      }

      .swiper-button-disabled {
        color: var(--color-slate-400);
      }
    }
    &__slide {
      // margin-right: 51px;

      // width: auto;
      min-width: 0;

      transition: all var(--transition);

      @include laptop-min {
        padding-right: 50px;
      }
    }

    &__slide.custom-gap {
      transition: all var(--transition);

      @include laptop-min {
        justify-items: end;
        text-align: end;
        & .pet-card__price {
          justify-content: end;
          flex-direction: row-reverse;
        }

        & .pet-card__variation {
          justify-content: end;
          // flex-direction: row-reverse;
        }

        & .pet-card__rating {
          justify-content: end;
        }
        margin-right: 50px;
      }
    }

    &__slide.custom-text {
      transition: all var(--transition);

      @include laptop-min {
        justify-items: end;
        text-align: end;
        & .pet-card__price {
          justify-content: end;
          flex-direction: row-reverse;
        }

        & .pet-card__variation {
          justify-content: end;
          // flex-direction: row-reverse;
        }

        & .pet-card__rating {
          justify-content: end;
        }
      }
    }
  }
</style>
