---
interface Props {
  src: string;
}

const { src } = Astro.props;
---

<section class="hero">
  <img {src} alt="" class="hero__back" />
  <div class="hero__container"><slot /></div>
</section>

<style is:global lang="scss">
  .hero {
    height: 200px;
    display: grid;

    @include laptop-min {
      height: 100%;
      max-height: 520px;
    }

    &__back {
      grid-area: 1 / 1;
      width: 100%;
      height: 0;
      object-fit: cover;
      min-height: 100%;
    }

    &__container {
      grid-area: 1 / 1;

      height: 100%;

      background: rgba(0, 0, 0, 0.3);
    }
  }
</style>
