---
interface Props {
  src: string;
}

const { src } = Astro.props;
---

<section class="hero" style={`--hero-bg: url(${src});`}>
  <!-- <img {src} alt="" loading="lazy" class="hero__back" /> -->
  <div class="hero__container"><slot /></div>
</section>

<style is:global lang="scss">
  .hero {
    height: 0;
    min-height: 30vh;
    display: grid;

    @include phone-min {
      min-height: 60vh;
    }

    @include laptop-min {
      min-height: unset;
      height: 100%;
      max-height: 520px;
    }

    &__back {
      grid-area: 1 / 1;
      width: 100%;
      object-fit: cover;
      height: 0;
      min-height: 100%;
      @include laptop-min {
        display: none;
      }
    }

    &__container {
      grid-area: 1 / 1;

      height: 100%;

      background: rgba(0, 0, 0, 0.3);
      position: relative;
      &::before {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: var(--hero-bg);
        z-index: -1;
        background-size: cover;
        background-position: bottom;
        background-attachment: fixed;
      }
    }
  }
</style>
