---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "class"> {
  /**
   * Лейбл над инпутом
   */
  label?: string;

  /**
   * Сообщение об ошибке под инпутом
   */
  error?: string;

  under?: string;
}

const { label, error, under, ...restProps } = Astro.props;
---

<div {...restProps} class="field">
  {label ? <label class="field__label">{label}</label> : null}

  <div class="field__input">
    <slot />
  </div>

  {
    error ? (
      <div class="field__bottom">
        <div class="field__error">{error}</div>
        {under ? <div class="field__under">{under}</div> : null}
      </div>
    ) : null
  }
</div>

<style is:global lang="scss">
  .field {
    position: relative;
    display: grid;
    gap: 13px;

    &__label {
      font-weight: 400;
      font-size: 14px;
      line-height: 1;
      color: var(--color-slate-400);
    }

    &__input {
      display: grid;
    }

    &__bottom {
      padding-top: 10px;
      display: flex;
      justify-content: space-between;
    }

    &__error {
      // position: absolute;
      color: var(--color-pink-400);

      font-weight: 400;
      font-size: 14px;
      line-height: 1;
    }

    &__under {
      // position: absolute;

      font-weight: 400;
      font-size: 14px;
      line-height: 1;
    }
  }
</style>
