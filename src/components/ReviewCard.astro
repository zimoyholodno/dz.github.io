---
import Icon from "./Icon.astro";
import Prose from "./Prose.astro";

interface Props {
  name: string;
  date: string;
  text: string[];

  star: "one" | "two" | "three" | "four" | "five";
}

const { name, date, text, star } = Astro.props;
---

<div class="review-card">
  <div class="review-card__top">
    <div class="review-card__top-container">
      <span>{name}</span>

      <div class="review-card__star">
        {
          [1, 2, 3, 4, 5].map(() => (
            <Icon
              icon="star"
              class:list={[
                "review-card__star-item",
                star && `review-card__star-item--${star}`,
              ]}
            />
          ))
        }
      </div>
    </div>
    <p class="review-card__date">
      {date}
    </p>
  </div>
  <Prose variant="guarantees">
    {text.map((item) => <p>{item}</p>)}
  </Prose>
</div>

<style is:global lang="scss">
  .review-card {
    border-bottom: 1px solid var(--color-slate-200);
    padding-bottom: 10px;

    @include laptop-min {
      padding-bottom: 30px;
    }

    &__top {
      display: grid;
      gap: 10px;

      &-container {
        display: flex;
        gap: 10px;
        font-weight: 600;
        font-size: 14px;
        line-height: 1.6;

        @include laptop-min {
          font-size: 16px;
          gap: 24px;
        }
      }
    }

    &__star {
      display: flex;
      gap: 6px;

      &-item {
        &--one {
          color: var(--color-slate-400);
          &:first-child {
            color: var(--color-slate-950);
          }
        }
        &--two {
          &:nth-child(n + 3) {
            color: var(--color-slate-400);
          }
        }
        &--three {
          &:nth-child(n + 4) {
            color: var(--color-slate-400);
          }
        }
        &--four {
          &:last-child {
            color: var(--color-slate-400);
          }
        }
        &--five {
        }
      }
    }

    &__date {
      font-weight: 400;
      font-size: 12px;
      line-height: 1;

      color: var(--color-slate-400);
    }
  }
</style>
