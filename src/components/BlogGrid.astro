<style is:global lang="scss">
  .blog-grid {
    display: grid;
    justify-items: center;
    gap: 50px;

    &__container {
      display: grid;
      grid-template-columns: 100%;
      gap: 40px;

      @include tablet-min {
        grid-template-columns: 1fr 1fr;
        gap: 50px;
      }

      @include laptop-min {
        grid-template-columns: 1fr 1fr 1fr;
      }
    }

    &__button {
      display: grid;
      width: 100%;

      @include laptop-min {
        width: 226px;
      }
    }
  }
</style>
