---
import AskCircle from "./AskCircle.astro";
import PetDescription from "./PetDescription.astro";
import Tab from "./Tab.astro";

interface Props {}

const {} = Astro.props;

const tabs: string[] = ["ОПИСАНИЕ", "СОСТАВ", "ДОПОЛНИТЕЛЬНАЯ ИНФОРМАЦИЯ"];

const list: {
  title?: string;
  article?: number;
  text: string[];
  property?: boolean;
}[] = [
  {
    title: "MISSONI Missoni",
    article: 82860200001,
    text: [
      "Туалетная вода Missoni — аромат, вдохновленный ранним восходом солнца. Первыми лучами, пробивающимися сквозь облака и стремящимся напитать землю своим теплом. Неимоверно свежий, яркий и очень женственный. Missoni — настолько тонкий аромат, что носить его может неимоверно чувственная женщина, имеющая особый, женский магнетизм. Оформление флакона туалетной воды основано на мягком переливе согревающих теплых оттенков, свойственных именно этому бренду. Фруктово-цветочный аромат наполнен запахами водяной лилии, груши, апельсина, розового перца, белой фрезии, гелиотропа, пиона, белого кедра и мускуса. Всего пара капель этого прекрасного парфюма подарит прекрасное настроение на весь день!",
    ],
    property: true,
  },
  {
    text: [
      "Туалетная вода Missoni — аромат, вдохновленный ранним восходом солнца. Первыми лучами, пробивающимися сквозь облака и стремящимся напитать землю своим теплом. Неимоверно свежий, яркий и очень женственный. Missoni — настолько тонкий аромат, что носить его может неимоверно чувственная женщина, имеющая особый, женский магнетизм. Оформление флакона туалетной воды основано на мягком переливе согревающих теплых оттенков, свойственных именно этому бренду. Фруктово-цветочный аромат наполнен запахами водяной лилии, груши, апельсина, розового перца, белой фрезии, гелиотропа, пиона, белого кедра и мускуса. Всего пара капель этого прекрасного парфюма подарит прекрасное настроение на весь день!",
    ],
  },
  {
    text: [
      "Туалетная вода Missoni — аромат, вдохновленный ранним восходом солнца.",
      "Оформление флакона туалетной воды основано на мягком переливе согревающих теплых оттенков, свойственных именно этому бренду. Фруктово-цветочный аромат наполнен запахами водяной лилии, груши, апельсина, розового перца, белой фрезии, гелиотропа, пиона, белого кедра и мускуса",
    ],
  },
];
---

<div class="pet-tab">
  <div class="pet-tab__container">
    <Tab items={tabs} open={1}>
      {
        list.map(({ title, article, text, property }) => (
          <div class="tab__content">
            <PetDescription {title} {article} {text} {property} />
          </div>
        ))
      }
    </Tab>
    <AskCircle />
  </div>
</div>

<style is:global lang="scss">
  .pet-tab {
    @include laptop-min {
      // padding-top: 44px;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    @include widescreen-min {
      grid-template-columns: 615px 715px;
    }

    &__container {
      @include laptop-min {
        grid-column-start: 2;
      }
    }
  }
</style>
