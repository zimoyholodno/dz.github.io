---
/**
 * Компонент cookie banner
 *
 * https://spaceapp.ru/Wiki/Article?articleId=14043
 */
import Button from "./button/Button.astro";

interface Props {}

const {} = Astro.props;
---

<div class="cookie-banner">
  <button data-cookie-close class="cookie-banner__close icon-cross"></button>

  <div class="cookie-banner__container">
    <div class="cookie-banner__content">
      <div class="cookie-banner__title">Наш сайт использует cookie</div>
      <p class="cookie-banner__text">
        Сайт использует cookie-файлы для обеспечения удобства пользователей,
        анализа посещаемости и улучшения работы сервиса. Продолжая использовать
        сайт, вы соглашаетесь с обработкой этих данных в соответствии с нашей
        политикой конфиденциальности.
      </p>
    </div>
    <Button data-cookie-accept variant="black" size="small">Принять</Button>
  </div>
</div>

<style is:global lang="scss">
  .cookie-banner {
    display: none;
    position: fixed;
    justify-content: flex-end;

    padding: 24px;
    bottom: 24px;
    right: 0px;
    background-color: white;

    box-shadow: 0px 10px 40px 0px #0000001a;

    @include laptop-min {
      right: 24px;
      max-width: 440px;
    }

    &__container {
      display: flex;
      flex-direction: column;
      gap: 24px;

      @include laptop-min {
        max-width: 440px;
      }
    }

    &__content {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    &__close {
      height: 16px;
      cursor: pointer;

      position: absolute;
      top: 5px;
      right: 10px;
      font-size: 20px;
      color: black;
    }
  }
</style>
