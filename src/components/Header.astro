---
import Burger from "./Burger.astro";
import Button from "./button/Button.astro";
import Navigation from "./Navigation.astro";
import Drawer from "./Drawer.astro";
import Icon from "./Icon.astro";

interface Props {
  theme?: "dark" | "light";
}

const { theme } = Astro.props;

const mobileMenuTrigger = "mobile-menu";
---

<header class:list={["header", theme && `header--${theme}`]}>
  <div class="header__container">
    <div class="header__desktop">
      <a href="/index.html" class="header__logo">
        <Icon icon="logo" class="header__logo-img" />
      </a>

      <div class="header__navigation">
        <Navigation />
      </div>
    </div>
  </div>
  <div class="header__mobile">
    <Burger name={mobileMenuTrigger} />

    <a href="/index.html" class="header__logo">
      <Icon icon="logo" class="header__logo-img" />
    </a>
  </div>
</header>
<Drawer name={mobileMenuTrigger} variant="primary" position="left">
  <Navigation />
</Drawer>

<style is:global lang="scss">
  .header {
    // @include section;
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;

    z-index: 100;

    flex-grow: 0;
    color: var(--color-slate-950);

    @include laptop-min {
      color: var(--color-white);
      position: relative;
    }

    &__container {
      @include section;
      transition: var(--transition);
      transition-property:
        background-color, color, padding-block, border-bottom;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;

      z-index: 100;

      &-web {
        display: flex;
        gap: 40px;

        justify-self: end;
      }

      @include laptop-min {
        border-bottom: 1px solid var(--color-slate-200);
        padding-top: 20px;
        display: grid;
        gap: 10px;
      }
    }

    &__desktop {
      display: none;
      grid-area: center;
      @include laptop-min {
        // padding-top: 20px;
        display: grid;
        transition: var(--transition);
        transition-property: gap;
        gap: 10px;
      }
    }

    &__mobile {
      grid-area: center;
      padding: 8px 15px;
      display: flex;
      justify-content: space-between;

      position: relative;
      z-index: 100;

      // display: grid;
      // grid-template-columns: auto 1fr;
      align-items: center;

      color: var(--color-slate-950);

      gap: 50px;

      height: 58px;
      grid-area: full;
      border-bottom: 1px solid var(--color-slate-200);

      background-color: var(--color-white);

      &-content {
        display: flex;
        justify-content: space-between;
        align-items: center;

        width: 100%;

        @include phone-min {
          justify-content: flex-end;
          gap: 50px;
        }

        //
      }

      @include laptop-min {
        display: none;
      }
    }

    &__logo {
      justify-self: center;
      font-size: 42px;
      height: 42px;
      text-align: center;

      display: flex;
      align-items: center;

      transition: var(--transition);
      transition-property: color, transform;
    }

    &__logo:hover {
      color: var(--color-pink-400);
    }

    &__navigation {
      display: none;
      transition: var(--transition);
      transition-property: opacity, height, visibility, transform;
      height: 50px;

      @include laptop-min {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
      }
    }

    &--scroll &__container {
      background-color: var(--color-white);
      color: var(--color-slate-950);

      @include laptop-min {
        padding-block: 10px;
      }
    }

    &--scroll &__desktop {
      gap: 0px;
    }
    &--scroll &__navigation {
      height: 0;
      opacity: 0;
    }

    &--white &__container {
      background-color: var(--color-white);
      color: var(--color-slate-950);
    }

    &:hover &__container {
      background-color: var(--color-white);
      border-bottom: unset;
      color: var(--color-slate-950);
    }

    &--dark {
      color: var(--color-slate-950);
    }

    &--light {
      @include laptop-min {
        color: var(--color-white);
      }
    }
  }
</style>
