---
interface Props {
  side?: boolean;
  src?: string;
  center?: boolean;
  contain?: boolean;
}

const { side, src, center, contain } = Astro.props;
---

<div
  class:list={[
    "image-columns",
    side && `image-columns--left`,
    center && `image-columns--center`,
    contain && `image-columns--contain`,
  ]}
>
  <div class="image-columns__col"><slot /></div>

  {
    src && (
      <div class="image-columns__image">
        <img {src} alt="" class="image-columns__img" />
      </div>
    )
  }
</div>

<style is:global lang="scss">
  .image-columns {
    display: flex;
    flex-direction: column;
    gap: 10px;

    @include laptop-min {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
    }

    @include widescreen-min {
      gap: 100px;
    }

    &__col {
      display: grid;
      gap: 105px;
    }

    &__image {
      width: 100%;

      height: 200px;
      max-height: 618px;

      overflow: hidden;

      @include phone-min {
        height: 300px;
      }

      @include laptop-min {
        min-height: 458px;
        height: 100%;
      }
    }

    &__img {
      width: 100%;
      height: 0;
      object-fit: cover;
      min-height: 100%;
    }

    &--left &__image {
      grid-column: 1;
      grid-row: 1;
    }

    &--left &__col {
      grid-column: 2;
      grid-row: 1;
    }

    &--center &__col {
      align-items: center;
    }

    &--contain &__img {
      width: 100%;
      height: 0;
      min-height: 100%;
      object-fit: contain;
    }
  }
</style>
