---
import Breadcrumb from "./Breadcrumb.astro";
import Title from "./Title.astro";

interface Props {
  title: string;

  items: string[];

  variant: "dot" | "icon";
}

const { title, items, variant } = Astro.props;
---

<div class="secondary-hero">
  <div class="secondary-hero__title">
    <Title white size="large">{title}</Title>
  </div>
  <div class="secondary-hero__breadcrumb">
    <Breadcrumb {items} {variant} />
  </div>
</div>

<style is:global lang="scss">
  .secondary-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;

    width: 100%;
    height: 100%;
    justify-content: flex-end;
    padding-top: 100px;
    padding-bottom: 20px;

    @include laptop-min {
      // min-height: 420px;
      gap: 5px;
      min-height: 332px;
    }

    @include desktop-min {
      padding-top: 174px;
    }

    &__breadcrumb {
      width: 100%;
    }
  }
</style>
