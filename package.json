{
  "name": "astro-template",
  "type": "module",
  "version": "0.0.4",
  "scripts": {
    "dev": "astro dev",
    "build": "tsc && vite build --config vite-ts.config.ts && astro build && npm run format",
    "build-styles": "astro build",
    "build-script": "vite build --config vite-ts.config.ts",
    "watch-script": "vite build --config vite-ts.config.ts --watch",
    "preview": "astro preview",
    "astro": "astro",
    "format": "npx prettier build/*.html --config .prettier-html.cjs --write",
    "generate-icons": "svgtofont --sources ./public/icons --output ./public/fonts/icons"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "accordion-js": "^3.4.1",
    "air-datepicker": "^3.6.0",
    "astro": "^5.16.8",
    "astro-relative-links": "^0.4.2",
    "astrobook": "^0.11.2",
    "choices.js": "^11.1.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "gsap": "^3.14.2",
    "imask": "^7.6.1",
    "js-cookie": "^3.0.5",
    "jsdom": "^27.4.0",
    "lightgallery": "^2.9.0",
    "melt": "^0.44.0",
    "micromodal": "^0.6.1",
    "multer": "2.0.2",
    "nouislider": "^15.8.1",
    "runed": "^0.37.1",
    "swiper": "^12.0.3",
    "tailwindcss": "^4.1.18",
    "tippy.js": "^6.3.7",
    "vanilla-calendar-pro": "^3.0.5",
    "wnumb": "^1.2.0"
  },
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "^2.0.0",
    "@spaceapp/vite-plugin-typescript-build": "^0.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tsconfig/svelte": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/glidejs__glide": "^3.6.6",
    "@types/jsdom": "^27.0.0",
    "@types/micromodal": "^0.3.5",
    "@types/node": "^25.0.3",
    "@types/wnumb": "^1.2.3",
    "@yandex/ymaps3-types": "^1.0.18413413",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.3",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sass-embedded": "^1.97.2",
    "svelte": "^5.46.1",
    "svgtofont": "^6.5.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "packageManager": "pnpm@10.15.0"
}
